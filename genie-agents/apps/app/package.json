{
  "name": "pulso-retail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "dev:mock": "VITE_MOCK_MODE=true vite --config client/vite.config.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsdown -c tsdown.server.config.ts",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p ./tsconfig.server.json --noEmit && tsc -p ./tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prebuild": "npm run sync",
    "predev": "npm run sync",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types"
  },
  "dependencies": {
    "@databricks/appkit": "0.72.0",
    "@databricks/appkit-ui": "0.72.0",
    "@databricks/sdk-experimental": "0.17.0",
    "clsx": "2.1.1",
    "lucide-react": "0.554.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "^1.0.0",
    "tailwindcss": "^4.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/express": "4.17.25",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.6.2",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
